{
  "project": "NetworkLab",
  "environment": "stage-lab",
  "scope": {
    "model": "software-only",
    "physical_hardware_required": false,
    "production_network_allowed": false
  },
  "monitoring": {
    "interval_seconds": 30,
    "connectivity_targets": [
      "127.0.0.1"
    ],
    "services": [
      "Dnscache",
      "Dhcp",
      "NlaSvc"
    ]
  },
  "network": {
    "interfaces": [],
    "dns_servers": [],
    "virtual": {
      "provider": "VirtualBox",
      "name": "NetworkLab-Lab",
      "mode": "host-only",
      "subnet": "192.168.77.0/24",
      "host_ip": "192.168.77.1",
      "dhcp": {
        "ip": "192.168.77.2",
        "range": [
          "192.168.77.100",
          "192.168.77.200"
        ]
      },
      "internet_access": false,
      "physical_bridge": false
    }
  },
  "safety": {
    "configuration_enabled": false,
    "require_lab_scope": true
  }
}
